#include <windows.h>
#include "resource.h"
#include "../src/version.h"

IDI_APP ICON "retroamp.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "retroamp.manifest"

// ---- built-in default skin (Winamp 2.x layout, HD 4x PNG sheets) ----
MAIN_BMP      RCDATA "skin/main.png"
CBUTTONS_BMP  RCDATA "skin/cbuttons.png"
TITLEBAR_BMP  RCDATA "skin/titlebar.png"
SHUFREP_BMP   RCDATA "skin/shufrep.png"
TEXT_BMP      RCDATA "skin/text.png"
NUMBERS_BMP   RCDATA "skin/numbers.png"
NUMS_EX_BMP   RCDATA "skin/nums_ex.png"
VOLUME_BMP    RCDATA "skin/volume.png"
BALANCE_BMP   RCDATA "skin/balance.png"
MONOSTER_BMP  RCDATA "skin/monoster.png"
PLAYPAUS_BMP  RCDATA "skin/playpaus.png"
POSBAR_BMP    RCDATA "skin/posbar.png"
EQMAIN_BMP    RCDATA "skin/eqmain.png"
PLEDIT_BMP    RCDATA "skin/pledit.png"
PLEDIT_TXT    RCDATA "skin/pledit.txt"
VISCOLOR_TXT  RCDATA "skin/viscolor.txt"
// cassette deck on the back of the playlist (RetroAmp animation extension)
ANIM_TXT      RCDATA "skin/anim.txt"
PANEL_BMP     RCDATA "skin/panel.png"
REEL1_BMP     RCDATA "skin/reel1.png"
REEL2_BMP     RCDATA "skin/reel2.png"
VULEFT_BMP    RCDATA "skin/vuleft.png"
VURIGHT_BMP   RCDATA "skin/vuright.png"
LED_BMP       RCDATA "skin/led.png"
DSPBODY_BMP   RCDATA "skin/dspbody.png"
DSPBTN_BMP    RCDATA "skin/dspbtn.png"

IDD_INPUT DIALOGEX 0, 0, 300, 74
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "RetroAmp"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_INPUT_PROMPT, 8, 8, 284, 10
    EDITTEXT        IDC_INPUT_EDIT, 8, 22, 284, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 188, 50, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 242, 50, 50, 16
END

IDD_JUMP DIALOGEX 0, 0, 320, 220
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Jump to file"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT        IDC_JUMP_EDIT, 8, 8, 304, 14, ES_AUTOHSCROLL
    LISTBOX         IDC_JUMP_LIST, 8, 26, 304, 166, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "Play", IDOK, 208, 198, 50, 16
    PUSHBUTTON      "Close", IDCANCEL, 262, 198, 50, 16
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RETROAMP_VER_MAJOR,RETROAMP_VER_MINOR,RETROAMP_VER_PATCH,0
 PRODUCTVERSION RETROAMP_VER_MAJOR,RETROAMP_VER_MINOR,RETROAMP_VER_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "RetroAmp audio player"
            VALUE "FileVersion", RETROAMP_VERSION_A
            VALUE "ProductName", "RetroAmp"
            VALUE "ProductVersion", RETROAMP_VERSION_A
            VALUE "OriginalFilename", "RetroAmp.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
